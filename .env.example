PROJECT_NAME="Nombre de tu API"
SQLALCHEMY_DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/nombre_db"

# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres aleatorios)
SECRET_KEY="genera-una-clave-segura-con-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Cloudinary
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# Redis
REDIS_URL="rediss://default:password@host:port"

# CORS: lista de orígenes separados por coma (sin espacios)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://tu-app.vercel.app"
